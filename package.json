{
  "name": "hanmar-chat-hub-desktop",
  "version": "0.1.5",
  "description": "Hanmar Chat Hub - desktop app (Electron) untuk monitoring & membalas chat WhatsApp, Messenger, Telegram, Instagram DM dalam satu jendela.",
  "main": "src/main.js",
  "author": "Hanmar",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "id.biz.hanmar.chathub",
    "productName": "Hanmar Chat Hub",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "HanmarChatHub-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "handypurba",
        "repo": "hanmar-chat-hub-desktop"
      }
    ]
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "node-machine-id": "^1.1.12"
  }
}
